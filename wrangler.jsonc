// Hosting for research.cafesecurity.com on Cloudflare (Workers static assets).
// Cloudflare builds the site with scripts/build_site.py and mkdocs, then serves _site/.
{
  "name": "cafesecurity-research",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "research.cafesecurity.com", "custom_domain": true }
  ],
  // Served only at the custom domain: no workers.dev address and no preview
  // addresses. Pull requests are checked by the GitHub Actions build instead.
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false
}
